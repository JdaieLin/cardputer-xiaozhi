# XiaoZhi OTA endpoint (required for valid xiaozhi.me binding code)
XIAOZHI_OTA_URL=https://api.tenclass.net/xiaozhi/ota/

# XiaoZhi service endpoint (used after paired)
XIAOZHI_WS_URL=wss://api.tenclass.net/xiaozhi/v1/
XIAOZHI_WS_TOKEN=

# Device identity and auth
DEVICE_ID=
CLIENT_ID=
CLIENT_SECRET=

# Audio params for MVP
AUDIO_INPUT_RATE=16000
AUDIO_OUTPUT_RATE=24000
AUDIO_CHANNELS=1

# Runtime
LOG_LEVEL=info

# MCP local command tool (safe allowlist by default)
XIAOZHI_LOCAL_COMMAND_TOOL_ENABLED=true
XIAOZHI_LOCAL_COMMAND_ALLOWLIST=date,uptime,hostname,whoami,df,free,ip,iwgetid,vcgencmd
XIAOZHI_LOCAL_COMMAND_ALLOW_DANGEROUS=false
XIAOZHI_LOCAL_COMMAND_USE_SHELL=false
XIAOZHI_LOCAL_COMMAND_TIMEOUT_SEC=5
XIAOZHI_LOCAL_COMMAND_OUTPUT_LIMIT=4000
# Read once by the tool process, removed from its environment, and never advertised to the model.
XIAOZHI_LOCAL_COMMAND_SUDO_PASSWORD=

# MCP web search tool
XIAOZHI_WEB_TOOLS_ENABLED=true
XIAOZHI_WEB_TOOL_TIMEOUT_SEC=15
XIAOZHI_WEB_SEARCH_RESULT_LIMIT=5
XIAOZHI_WEB_TOOL_PROXY=http://192.168.100.124:7890
