# XiaoZhi OTA endpoint (required for valid xiaozhi.me binding code)
XIAOZHI_OTA_URL=https://api.tenclass.net/xiaozhi/ota/

# XiaoZhi service endpoint (used after paired)
XIAOZHI_WS_URL=wss://api.tenclass.net/xiaozhi/v1/
XIAOZHI_WS_TOKEN=

# Device identity and auth
DEVICE_ID=
CLIENT_ID=
CLIENT_SECRET=

# Audio params for MVP
AUDIO_INPUT_RATE=16000
AUDIO_OUTPUT_RATE=24000
AUDIO_CHANNELS=1

# Runtime
LOG_LEVEL=info

# Display: classic or audio-reactive Whisplay watercolor orb
XIAOZHI_DISPLAY_UI_STYLE=classic
XIAOZHI_WATERCOLOR_MIN_MEM_AVAILABLE_MB=64
XIAOZHI_WATERCOLOR_CRITICAL_MEM_AVAILABLE_MB=32
XIAOZHI_WATERCOLOR_MIN_CMA_FREE_MB=0
XIAOZHI_WATERCOLOR_RECOVERY_DELAY_SEC=5
XIAOZHI_WATERCOLOR_FPS=15
XIAOZHI_WATERCOLOR_DIAMETER=113
XIAOZHI_WATERCOLOR_RENDER_SCALE=0.60
XIAOZHI_WATERCOLOR_SMOOTH_FBM=true
XIAOZHI_WATERCOLOR_TEMPORAL_3D=true
XIAOZHI_WATERCOLOR_THREADS=2

# MCP local command tool (safe allowlist by default)
XIAOZHI_LOCAL_COMMAND_TOOL_ENABLED=true
XIAOZHI_LOCAL_COMMAND_ALLOWLIST=date,uptime,hostname,whoami,df,free,ip,iwgetid,vcgencmd
XIAOZHI_LOCAL_COMMAND_ALLOW_DANGEROUS=false
XIAOZHI_LOCAL_COMMAND_USE_SHELL=false
XIAOZHI_LOCAL_COMMAND_TIMEOUT_SEC=5
XIAOZHI_LOCAL_COMMAND_OUTPUT_LIMIT=4000
# Read once by the tool process, removed from its environment, and never advertised to the model.
XIAOZHI_LOCAL_COMMAND_SUDO_PASSWORD=

# MCP web search tool
XIAOZHI_WEB_TOOLS_ENABLED=true
XIAOZHI_WEB_TOOL_TIMEOUT_SEC=15
XIAOZHI_WEB_SEARCH_RESULT_LIMIT=5
XIAOZHI_WEB_TOOL_PROXY=http://192.168.100.124:7890

# MCP camera tool (advertised only when the camera device and rpicam-still exist)
XIAOZHI_CAMERA_TOOL_ENABLED=true
XIAOZHI_CAMERA_DEVICE=/dev/video0
XIAOZHI_CAMERA_COMMAND=rpicam-still
XIAOZHI_CAMERA_WIDTH=640
XIAOZHI_CAMERA_HEIGHT=480
XIAOZHI_CAMERA_JPEG_QUALITY=80
XIAOZHI_CAMERA_WARMUP_MS=600
XIAOZHI_CAMERA_SENSOR_MODE=640:480:10:P
XIAOZHI_CAMERA_TIMEOUT_SEC=12
XIAOZHI_CAMERA_VISION_TIMEOUT_SEC=30
